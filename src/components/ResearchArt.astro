---
// Looping illustrations for the Research page, one per paper. Each acts out what the paper does.
// Motion lives in motion.css; without it every drawing shows its final state.
interface Props {
  id: string;
}
const { id } = Astro.props;

// ISARC: isometric projection of a 9 x 6 plan, three storeys.
const c = 0.866;
const s = 11;
const W = 9;
const D = 6;
const h = 2.6;
const ox = 143;
const oy = 92;
const P = (x: number, y: number, z: number) => `${(ox + (x - y) * c * s).toFixed(1)},${(oy + (x + y) * 0.5 * s - z * s).toFixed(1)}`;
const storeys = [0, 1, 2].map((k) => {
  const z0 = k * h;
  const z1 = (k + 1) * h;
  return {
    left: [P(0, D, z0), P(W, D, z0), P(W, D, z1), P(0, D, z1)].join(' '),
    right: [P(W, 0, z0), P(W, D, z0), P(W, D, z1), P(W, 0, z1)].join(' '),
    top: [P(0, 0, z1), P(W, 0, z1), P(W, D, z1), P(0, D, z1)].join(' '),
  };
});
const roof = 3 * h;
const roofLines = [
  [P(4, 0, roof), P(4, D, roof)],
  [P(4, 3, roof), P(W, 3, roof)],
  [P(7, 3, roof), P(7, D, roof)],
];
// Plan view in plan units (s per metre); the group is moved into place by CSS.
const planLines = [
  [0, 0, W * s, 0],
  [W * s, 0, W * s, D * s],
  [W * s, D * s, 0, D * s],
  [0, D * s, 0, 0],
  [4 * s, 0, 4 * s, D * s],
  [4 * s, 3 * s, W * s, 3 * s],
  [7 * s, 3 * s, 7 * s, D * s],
];
---

<svg viewBox="0 0 320 200" class:list={['ra', `ra--${id}`]} aria-hidden="true">
  {
    id === 'isarc2026' && (
      <>
        <g class="ra-plan">
          {planLines.map(([x1, y1, x2, y2], i) => (
            <line class="ra-plan-line" style={`--i: ${i}`} pathLength="1" stroke-dasharray="1" x1={x1} y1={y1} x2={x2} y2={y2} stroke="#1A1D21" stroke-width="1.5" />
          ))}
        </g>
        <text class="ra-label ra-dxf" x="20" y="186">DXF plan</text>
        {storeys.map((st, k) => (
          <g class={`ra-storey ra-storey-${k}`}>
            <polygon points={st.left} fill="#F1F2EE" stroke="#1A1D21" stroke-width="1.2" stroke-linejoin="round" />
            <polygon points={st.right} fill="#E6E7E2" stroke="#1A1D21" stroke-width="1.2" stroke-linejoin="round" />
            <polygon points={st.top} fill={k === 2 ? '#FBEDE6' : '#FFFFFF'} stroke="#1A1D21" stroke-width="1.2" stroke-linejoin="round" />
          </g>
        ))}
        <g class="ra-roof" stroke="#C2410C" stroke-width="1.5">
          {roofLines.map(([a, b]) => {
            const [x1, y1] = a.split(',');
            const [x2, y2] = b.split(',');
            return <line x1={x1} y1={y1} x2={x2} y2={y2} />;
          })}
        </g>
        <text class="ra-label ra-ifc" x="300" y="186" text-anchor="end">IFC model, 3 storeys</text>
      </>
    )
  }
  {
    id === 'icccbe2026' && (
      <>
        <defs>
          <pattern id="raDots" width="6" height="6" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.8" r="0.8" fill="#1A1D21" />
            <circle cx="4.5" cy="4.6" r="0.8" fill="#1A1D21" />
          </pattern>
        </defs>
        <line x1="50" y1="168" x2="270" y2="168" stroke="#9AA0A6" stroke-width="1" />
        <rect class="ra-dots" x="100" y="40" width="120" height="128" fill="url(#raDots)" />
        <g class="ra-model" fill="none" stroke="#1A1D21" stroke-width="1.5">
          <rect pathLength="1" stroke-dasharray="1" x="100" y="40" width="120" height="128" />
          {[58, 96, 134].map((y) => [114, 149, 184].map((x) => <rect pathLength="1" stroke-dasharray="1" x={x} y={y} width="22" height="18" />))}
        </g>
        <g class="ra-heat" fill="#C2410C">
          {[
            [114, 58, 0.85], [149, 58, 0.45], [184, 58, 0.7],
            [114, 96, 0.55], [149, 96, 0.9], [184, 96, 0.35],
            [114, 134, 0.75], [149, 134, 0.5], [184, 134, 0.8],
          ].map(([x, y, o]) => <rect x={x} y={y} width="22" height="18" fill-opacity={o} />)}
        </g>
        <line class="ra-beam" x1="100" y1="30" x2="100" y2="176" stroke="#C2410C" stroke-width="2" />
        <text class="ra-label ra-scan" x="20" y="186">Point cloud</text>
        <text class="ra-label ra-loss" x="300" y="186" text-anchor="end">Where heat escapes</text>
      </>
    )
  }
  {
    id === 'i3ce2026' && (
      <>
        <defs>
          <pattern id="raSoil" width="7" height="7" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="0.7" fill="#9AA0A6" />
            <circle cx="5.5" cy="5.5" r="0.7" fill="#9AA0A6" />
          </pattern>
        </defs>
        <rect x="10" y="74" width="300" height="106" fill="url(#raSoil)" />
        <rect x="70" y="74" width="190" height="80" fill="#FAFAF7" />
        <path d="M70 74 V154 H260 V74" fill="none" stroke="#1A1D21" stroke-width="1.2" />
        <line x1="10" y1="74" x2="310" y2="74" stroke="#1A1D21" stroke-width="1.5" />
        <line x1="30" y1="136" x2="290" y2="136" stroke="#1A1D21" stroke-width="7" stroke-linecap="round" />
        <g stroke="#1A1D21" stroke-width="1.5" fill="none">
          <line x1="40" y1="48" x2="30" y2="74" />
          <line x1="40" y1="48" x2="50" y2="74" />
          <line x1="40" y1="48" x2="40" y2="74" />
        </g>
        <circle cx="40" cy="44" r="6" fill="#1A1D21" />
        <g class="ra-rays" stroke="#C2410C" stroke-width="1">
          {[90, 130, 170, 210, 250].map((x, i) => (
            <line class="ra-ray" style={`--i: ${i}`} pathLength="1" stroke-dasharray="1" x1="40" y1="44" x2={x} y2="131" />
          ))}
        </g>
        <g class="ra-points" fill="#C2410C">
          {Array.from({ length: 24 }, (_, i) => <circle cx={84 + i * 7.6} cy={i % 2 ? 130.5 : 132} r="1.4" />)}
        </g>
        <g class="ra-tablet">
          <rect x="150" y="26" width="120" height="146" rx="10" fill="#FFFFFF" fill-opacity="0.55" stroke="#1A1D21" stroke-width="2" />
          <line x1="160" y1="136" x2="260" y2="136" stroke="#C2410C" stroke-width="7" stroke-linecap="round" />
          <text class="ra-label" x="210" y="120" text-anchor="middle" fill="#C2410C">as laid</text>
        </g>
        <text class="ra-label ra-tls" x="20" y="194">Laser scan</text>
        <text class="ra-label ra-ar" x="300" y="194" text-anchor="end">AR on site</text>
      </>
    )
  }
  {
    id === 'housing2025' && (
      <>
        <rect x="70" y="40" width="180" height="120" fill="#FFFFFF" stroke="#1A1D21" stroke-width="1.5" />
        <g stroke="#1A1D21" stroke-width="1.2" fill="none">
          <g class="ra-rule ra-rule-1">
            <line pathLength="1" stroke-dasharray="1" x1="70" y1="96" x2="250" y2="96" />
            <line pathLength="1" stroke-dasharray="1" x1="70" y1="104" x2="250" y2="104" />
          </g>
          <g class="ra-rule ra-rule-2">
            {[115, 160, 205].map((x) => <line pathLength="1" stroke-dasharray="1" x1={x} y1="40" x2={x} y2="96" />)}
          </g>
          <g class="ra-rule ra-rule-3">
            {[130, 190].map((x) => <line pathLength="1" stroke-dasharray="1" x1={x} y1="104" x2={x} y2="160" />)}
          </g>
        </g>
        <g class="ra-pick">
          <rect x="160" y="40" width="45" height="56" fill="#FBEDE6" stroke="#C2410C" stroke-width="1.5" />
          <polyline points="173,69 180,76 193,61" fill="none" stroke="#C2410C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <text class="ra-label ra-r1" x="20" y="186">Rule 1</text>
        <text class="ra-label ra-r2" x="20" y="186">Rule 2</text>
        <text class="ra-label ra-r3" x="20" y="186">Rule 3</text>
        <text class="ra-label ra-eval" x="300" y="186" text-anchor="end">Scored on local data</text>
      </>
    )
  }
</svg>
