---
// Every submission over the competition window, with the best-so-far line.
// Emphasis form: new bests in the accent, the rest in de-emphasis grey.
import { facts, leaderboard, submissions } from '../../data/marine-debris';
import { fmtStamp, fmtScore } from '../../lib/format';

const W = 640;
const H = 320;
const m = { l: 40, r: 16, t: 14, b: 30 };
const pw = W - m.l - m.r;
const ph = H - m.t - m.b;

const t0 = Date.parse('2026-08-15T12:00:00');
const t1 = Date.parse('2026-09-01T12:00:00');
const y0 = 0.25;
const y1 = 0.85;
const x = (iso: string) => m.l + ((Date.parse(iso) - t0) / (t1 - t0)) * pw;
const y = (v: number) => m.t + (1 - (v - y0) / (y1 - y0)) * ph;

let best = -1;
const pts = submissions.map((s, i) => {
  const prev = best;
  const isBest = s.score > best + 1e-9;
  if (isBest) best = s.score;
  return { ...s, i, isBest, prev, bestAfter: best, cx: x(s.at), cy: y(s.score) };
});

// Best-so-far as a step line.
let d = '';
pts.forEach((p, i) => {
  const by = y(p.bestAfter);
  d += i === 0 ? `M${p.cx},${by}` : `H${p.cx}V${by}`;
});
d += `H${m.l + pw}`;

const cutoff = leaderboard[facts.finalists - 1].privateScore;
const yTicks = [0.3, 0.4, 0.5, 0.6, 0.7, 0.8];
const xTicks = ['2026-08-15', '2026-08-18', '2026-08-21', '2026-08-24', '2026-08-27', '2026-08-30', '2026-09-01'].map((iso) => ({
  x: x(`${iso}T00:00:00`),
  label: fmtStamp(`${iso}T00:00:00`, false),
}));

const first = pts[0];
const crossed = pts.find((p) => p.score >= facts.qualifyingFloor)!;
const top = pts.reduce((a, b) => (b.score > a.score ? b : a));

// Hover bands: each submission owns the x-range halfway to its neighbours.
const hits = pts.map((p, i) => {
  const left = i === 0 ? m.l : (pts[i - 1].cx + p.cx) / 2;
  const right = i === pts.length - 1 ? m.l + pw : (p.cx + pts[i + 1].cx) / 2;
  const note = p.isBest
    ? p.prev > 0
      ? `New best, +${(p.score - p.prev).toFixed(3)}`
      : 'First submission'
    : `${(p.prev - p.score).toFixed(3)} below the best so far`;
  return { x: left, w: Math.max(1, right - left), p, note };
});
---

<div class="chart" data-chart>
  <ul class="chart-legend" aria-hidden="true">
    <li><span class="key key--line"></span>Best score so far</li>
    <li><span class="key key--dot key--accent"></span>Set a new best</li>
    <li><span class="key key--dot key--grey"></span>Didn't beat the best</li>
  </ul>
  <div class="chart-scroll">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      class="chart-svg climb"
      role="img"
      tabindex="0"
      aria-label={`Line chart of ${pts.length} submissions from 15 August to 1 September. The best public score rose from ${fmtScore(first.score, 3)} to ${fmtScore(top.score, 4)}, crossing the ${facts.qualifyingFloor.toFixed(2)} qualifying floor on 18 August. Use the arrow keys to step through submissions.`}
    >
      <g class="grid">
        {yTicks.map((v) => <line x1={m.l} x2={m.l + pw} y1={y(v)} y2={y(v)} />)}
      </g>
      <g class="tick-labels" text-anchor="end">
        {yTicks.map((v) => <text x={m.l - 8} y={y(v) + 4}>{v.toFixed(1)}</text>)}
      </g>
      <g class="tick-labels" text-anchor="middle">
        {xTicks.map((t) => <text x={t.x} y={H - 8}>{t.label}</text>)}
      </g>
      <line class="axis" x1={m.l} x2={m.l + pw} y1={m.t + ph} y2={m.t + ph} />

      <g class="ref">
        <line x1={m.l} x2={m.l + pw} y1={y(facts.qualifyingFloor)} y2={y(facts.qualifyingFloor)} />
        <text x={m.l + pw} y={y(facts.qualifyingFloor) + 15} text-anchor="end">Qualifying floor for the final {facts.qualifyingFloor.toFixed(2)}</text>
        <line x1={m.l} x2={m.l + pw} y1={y(cutoff)} y2={y(cutoff)} />
        <text x={m.l + pw} y={y(cutoff) - 7} text-anchor="end">10th place on the private board {fmtScore(cutoff, 4)}</text>
      </g>

      <path class="best-line draw-line" d={d} pathLength="1" />

      <g class="dots">
        {pts.filter((p) => !p.isBest).map((p) => <circle class="dot dot--grey" cx={p.cx} cy={p.cy} r="4" style={`--i: ${p.i}`} />)}
        {pts.filter((p) => p.isBest).map((p) => <circle class="dot dot--accent" cx={p.cx} cy={p.cy} r="4" style={`--i: ${p.i}`} />)}
      </g>

      <g class="annot">
        <text x={first.cx + 8} y={first.cy + 18}>First try {fmtScore(first.score, 3)}</text>
        <text x={crossed.cx - 8} y={y(0.567)} text-anchor="end">+{fmtScore(crossed.score - crossed.prev, 3)}</text>
        <text x={top.cx - 10} y={top.cy + 20} text-anchor="end">Best {fmtScore(top.score, 4)}</text>
      </g>

      <line class="crosshair" x1="0" x2="0" y1={m.t} y2={m.t + ph} />
      <circle class="focus-ring" r="7" cx="-20" cy="-20" />
      <g class="hits">
        {
          hits.map((h) => (
            <rect
              x={h.x}
              y={m.t}
              width={h.w}
              height={ph}
              data-x={h.p.cx}
              data-y={h.p.cy}
              data-title={fmtStamp(h.p.at, true)}
              data-value={fmtScore(h.p.score, 4)}
              data-note={h.note}
            />
          ))
        }
      </g>
    </svg>
  </div>
  <div class="chart-tip" role="status" aria-live="polite" hidden>
    <strong class="tip-value"></strong>
    <span class="tip-title"></span>
    <span class="tip-note"></span>
  </div>
  <details class="chart-table">
    <summary>Show all {pts.length} submissions as a table</summary>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">#</th><th scope="col">Submitted</th><th scope="col">Public mAP@0.5</th><th scope="col">Result</th></tr></thead>
        <tbody>
          {hits.map((h) => (
            <tr class:list={{ 'is-best': h.p.isBest }}>
              <td>{h.p.i + 1}</td><td>{fmtStamp(h.p.at, true)}</td><td>{fmtScore(h.p.score, 4)}</td><td>{h.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>
