---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ClimbChart from '../../components/charts/ClimbChart.astro';
import LeaderboardChart from '../../components/charts/LeaderboardChart.astro';
import { facts, leaderboard, submissions } from '../../data/marine-debris';
import { fmtDelta, fmtScore } from '../../lib/format';
import { url } from '../../lib/url';
import { personRef } from '../../lib/seo';

// Every number in the prose is derived here from the data, so text and charts agree.
const bestBy = (iso: string) => Math.max(...submissions.filter((s) => s.at <= iso).map((s) => s.score));
const first = submissions[0].score;
const best = Math.max(...submissions.map((s) => s.score));
const earlyGain = bestBy('2026-08-18T23:59:59') - first;
const lateGain = best - bestBy('2026-08-24T23:59:59');

let running = -1;
let newBests = 0;
for (const s of submissions) {
  if (s.score > running + 1e-9) {
    newBests++;
    running = s.score;
  }
}

const us = leaderboard.find((r) => r.us)!;
const cutoff = leaderboard[facts.finalists - 1].privateScore;
const top20 = leaderboard.slice(0, 20);
const changes = top20.map((r) => r.privateScore - (r.publicScore ?? r.privateScore)).sort((a, b) => a - b);
const median = (changes[9] + changes[10]) / 2;
const rose = top20.filter((r) => r.publicRank > r.privateRank).length;
const fell = top20.filter((r) => r.publicRank < r.privateRank).length;
const biggestRise = Math.max(...top20.map((r) => r.publicRank - r.privateRank));
const spread15 = leaderboard[0].privateScore - leaderboard[14].privateScore;
const ourChange = us.privateScore - (us.publicScore ?? us.privateScore);
---

<Base
  title="Marine debris detection"
  og="marine-debris"
  crumbs={[{ name: 'Work', path: 'work/' }, { name: 'Marine debris detection', path: 'work/marine-debris/' }]}
  schema={[
    {
      '@type': 'Article',
      headline: 'Marine debris detection: 37 submissions to 15th of 69 teams',
      author: personRef(Astro.site),
      datePublished: '2026-10-27',
      about: 'International AI Challenge on Marine Debris Image Recognition 2026',
      mainEntityOfPage: new URL(url('work/marine-debris/'), Astro.site).href,
      image: new URL(url('og/marine-debris.png'), Astro.site).href,
    },
  ]}
  current="work"
  description={`Case study: ${submissions.length} submissions took our marine debris detector from ${fmtScore(first, 3)} to ${fmtScore(best, 3)} mAP@0.5, finishing ${us.privateRank}th of ${facts.teamsEntered} teams.`}
>
  <div class="grid-paper">
    <div class="container page" style="padding-bottom: clamp(32px, 4vw, 56px)">
      <div class="page-head">
        <p class="eyebrow"><a href={url('work/')} class="underline-link" style="color: inherit">Work</a></p>
        <h1 class="page-title">Marine debris detection</h1>
        <p class="lede" style="max-width: 44rem">
          {`In ${submissions.length} submissions our detector went from ${fmtScore(first, 3)} to ${fmtScore(best, 3)} mAP. It finished ${us.privateRank}th of ${facts.teamsEntered} teams, ${fmtScore(cutoff - us.privateScore, 4)} short of the top-${facts.finalists} final.`}
        </p>
      </div>

      <dl class="stats" data-reveal>
        <div><dt>Final rank</dt><dd>{us.privateRank}<span class="unit">th of {facts.teamsEntered}</span></dd></div>
        <div><dt>Private mAP@0.5</dt><dd>{fmtScore(us.privateScore, 4)}</dd></div>
        <div><dt>Submissions</dt><dd>{submissions.length}<span class="unit">in 18 days</span></dd></div>
        <div><dt>Gap to the final</dt><dd>{fmtScore(cutoff - us.privateScore, 4)}</dd></div>
      </dl>
    </div>
  </div>

  <div class="container page" style="padding-top: 24px">
    <section aria-labelledby="challenge">
      <SectionHead no={1} id="challenge" title="The challenge" />
      <div class="case-split">
        <div class="case-prose" data-reveal>
          <p>
            The {facts.organiser} released an AI-ready dataset of sea litter photos and asked teams to
            detect every object in {facts.classes} categories (33 plus 1). We entered as a two-person team.
          </p>
          <p>
            Scoring is mAP at an IoU of 0.5, computed with the COCO API. A box counts only if it overlaps
            the true one by more than half, and the score averages over all {facts.classes} classes. So a rare,
            hard class weighs as much as a common, easy one.
          </p>
        </div>
        <dl class="spec" data-reveal style="--d: 1">
          <div><dt>Task</dt><dd>Object detection, {facts.classes} classes</dd></div>
          <div><dt>Metric</dt><dd>mAP@0.5, averaged over classes</dd></div>
          <div><dt>Window</dt><dd>15 Aug to 1 Sep 2026</dd></div>
          <div><dt>To reach the final</dt><dd>Top {facts.finalists} on the private board, mAP 0.60 or more</dd></div>
          <div><dt>Final prize pool</dt><dd>Up to {facts.prizePool}</dd></div>
        </dl>
      </div>
    </section>

    <section aria-labelledby="climb" class="case-section">
      <SectionHead no={2} id="climb" title="The climb" meta="Public leaderboard" />
      <p class="case-lead" data-reveal>
        By the end of 18 August the score had risen {fmtScore(earlyGain, 2)} mAP. The last eight days added {fmtScore(lateGain, 2)}.
      </p>
      <figure class="case-figure" data-reveal>
        <ClimbChart />
      </figure>
      <ul class="takeaways" data-reveal>
        <li><strong>{newBests} of {submissions.length}</strong> submissions set a new best. The other {submissions.length - newBests} didn't beat it, and they stay on the chart rather than hidden.</li>
        <li><strong>Over the 0.60 floor on day four.</strong> The biggest single jump, +0.103, took the score from 0.541 to 0.645 on 18 August.</li>
        <li><strong>Diminishing returns.</strong> After 21 August only one improvement, on 27 August, added more than 0.01. The best score, {fmtScore(best, 4)}, came on 30 August and is the one we chose at the deadline.</li>
      </ul>
    </section>

    <section aria-labelledby="landed" class="case-section">
      <SectionHead no={3} id="landed" title="Where it landed" meta="Private leaderboard" />
      <p class="case-lead" data-reveal>
        The top 15 finished within {fmtScore(spread15, 3)} mAP of each other. We were {fmtScore(cutoff - us.privateScore, 4)} below 10th place.
      </p>
      <figure class="case-figure" data-reveal>
        <LeaderboardChart rows={20} />
      </figure>
      <ul class="takeaways" data-reveal>
        <li><strong>The private test data reshuffled the board.</strong> Of the top 20, {rose} teams rose and {fell} fell. One team rose {biggestRise} places.</li>
        <li><strong>Our model held.</strong> Our score moved {fmtDelta(ourChange, 4)}, about the median change ({fmtDelta(median, 4)}). We went from {us.publicRank}th to {us.privateRank}th because others fell further.</li>
        <li><strong>The field.</strong> {facts.teamsScored} of the {facts.teamsEntered} teams that entered received a private score. The median was {fmtScore(leaderboard[Math.floor(leaderboard.length / 2)].privateScore, 3)}.</li>
      </ul>
    </section>

    <section aria-labelledby="learned" class="case-section">
      <SectionHead no={4} id="learned" title="What I took from it" />
      <div class="case-prose" data-reveal>
        <p>
          Most of our misses came from classes defined by what an object is not. Because the metric
          averages over classes, every one of those weak classes pulled the whole score down. The error
          analysis taught me the most.
        </p>
      </div>
      <p style="margin-top: 40px" data-reveal>
        <a href={url('work/')} class="underline-link"><span class="arrow" aria-hidden="true">←</span> All projects</a>
      </p>
    </section>
  </div>
</Base>

<script>
  import '../../scripts/chart-tips';
</script>
