---
import Base from '../layouts/Base.astro';
import { domains, projects } from '../data/projects';
import { href, isExternal } from '../lib/url';
import { Image } from 'astro:assets';

const filters = ['All', ...domains].map((label) => ({
  label,
  n: label === 'All' ? projects.length : projects.filter((p) => p.domain === label).length,
}));
const countLabel = (n: number) => (n === 1 ? '1 project' : `${n} projects`);
---

<Base
  title="Work"
  seoTitle="Work: BIM, vision and web projects — Victor Jean Viaunel"
  current="work"
  sheet={2}
  og="work"
  crumbs={[{ name: 'Work', path: 'work/' }]}
  description="Projects by Victor Jean Viaunel in scan-to-BIM, computer vision, AI datasets and web products, including MaiSchool and a 15th-place marine debris detector."
>
  <div class="grid-paper">
    <div class="container page" style="padding-bottom: 0">
      <div class="page-head">
        <p class="eyebrow">Work</p>
        <h1 class="page-title" data-lines>Things I've built</h1>
        <p class="lede">
          A published method for turning floor plans into BIM, a 15th-of-69 finish in an international
          detection challenge, and a live tutoring platform I've led since 2024. Most of it is about
          getting usable information out of sensor data.
        </p>
        <div class="filters" role="group" aria-label="Filter projects" hidden data-filters>
          {
            filters.map((f, i) => (
              <button type="button" class="filter" data-filter={f.label} aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.label}<span class="n" aria-hidden="true">{f.n}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="container page" style="padding-top: 0">
    <p class="project-count" aria-live="polite" data-project-count>{countLabel(projects.length)}</p>
    <div class="project-grid">
      {
        projects.map((p, i) => {
          const inner = (
            <>
              {p.shot && (
                <div class="product-shot card-shot">
                  <span class="product-bar" aria-hidden="true"><i></i><i></i><i></i><span>{p.shot.url}</span></span>
                  <Image src={p.shot.src} alt={p.shot.alt} widths={[400, 640, 960]} sizes="(min-width: 980px) 360px, 100vw" />
                </div>
              )}
              <div class="card-meta">
                <span class="kicker kicker--accent">{p.domain}</span>
                <span class="kicker">{p.status}</span>
              </div>
              <h2 data-vt={p.vt ? '' : undefined} style={p.vt ? `--vt: ${p.vt}` : undefined}>{p.title}</h2>
              {p.results.length > 0 && (
                <div class="chip-row outcome-row">
                  {p.results.map((m) => <span class="tag tag--accent">{m}</span>)}
                </div>
              )}
              <p class="body-text">{p.text}</p>
              {p.stack.length > 0 && (
                <div class="chip-row stack-row">
                  {p.stack.map((m) => <span class="tag">{m}</span>)}
                </div>
              )}
              {p.cta && p.href && (
                <span class="cta">
                  {p.cta}{' '}
                  {isExternal(p.href) ? (
                    <span class="arrow arrow--ne" aria-hidden="true">↗</span>
                  ) : (
                    <span class="arrow" aria-hidden="true">→</span>
                  )}
                </span>
              )}
            </>
          );
          const style = `--d: ${i % 3}; --vtn: project-${i}`;
          const wip = /in progress|up next/i.test(p.status);
          return p.href ? (
            <a class:list={['project-card frame', { 'is-wip': wip }]} href={href(p.href)} data-domain={p.domain} data-reveal style={style}>
              {inner}
            </a>
          ) : (
            <article class:list={['project-card', { 'is-wip': wip }]} data-domain={p.domain} data-reveal style={style}>
              {inner}
            </article>
          );
        })
      }
    </div>
  </div>
</Base>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const count = document.querySelector<HTMLElement>('[data-project-count]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let current: ViewTransition | undefined;

  if (group && count) {
    group.hidden = false;
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('button'));

    const apply = (filter: string) => {
      let shown = 0;
      for (const card of cards) {
        const visible = filter === 'All' || card.dataset.domain === filter;
        card.hidden = !visible;
        if (visible) {
          shown++;
          card.classList.add('is-in');
        }
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      count.textContent = shown === 1 ? '1 project' : `${shown} projects`;
    };

    group.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest('button');
      const filter = button?.dataset.filter;
      if (!filter || button.getAttribute('aria-pressed') === 'true') return;
      // Let cards glide to their new places where the browser supports it.
      if (!reduced && 'startViewTransition' in document) {
        const root = document.documentElement;
        root.classList.add('vt-filter');
        const vt = document.startViewTransition(() => apply(filter));
        current = vt;
        // A newer transition skips this one; only the latest may clear the class.
        vt.finished.finally(() => {
          if (current === vt) root.classList.remove('vt-filter');
        });
      } else {
        apply(filter);
      }
    });
  }
</script>
