---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
import { personRef } from '../lib/seo';

// Only show a CV button once its PDF is actually in public/cv/.
const hasFile = (p: string) => fs.existsSync(path.join(process.cwd(), 'public', p));
const cvLinks = [
  { label: 'Industry résumé (PDF)', file: site.cv.industry, primary: true },
  { label: 'Academic CV (PDF)', file: site.cv.academic, primary: false },
].filter((c) => hasFile(c.file));

const experience = [
  {
    when: 'Now',
    role: 'Assistant Researcher',
    org: 'H-Team lab, National Taiwan University',
    text: "Research on BIM and digital construction. Teaching assistant for Prof. Hsieh's BIM course, supporting students with practical topics and their implementation ideas.",
  },
  {
    when: '2024 – now',
    role: 'Lead Full-Stack Developer',
    org: 'Legend Castle',
    html: 'Main developer of <a href="https://maischool.legendcastle.org">MaiSchool</a>, a live online tutoring platform for families, from design to implementation: course and teacher browsing, class booking, progress tracking and parent messages. Built with Next.js, Convex, Clerk and Zod.',
  },
  {
    when: 'Now',
    role: 'Academic Committee Lead (second term)',
    org: 'Haitian student community in Taiwan',
    text: "Help bachelor's to graduate students apply to Taiwanese universities: study plans, autobiographies, application documents, and the workshops I coordinate.",
  },
  {
    when: 'Ongoing',
    role: 'Founder',
    org: 'GUANIN (Guanin Co., Ltd.)',
    text: 'A Taiwan-registered sourcing marketplace I run end to end: the platform, the suppliers, the buyers and the paperwork.',
  },
  {
    when: 'Feb – Jun 2023',
    role: 'Structural Engineering Intern',
    org: 'Envision',
    text: 'Worked as an assistant structural engineer, modelling and analysing structures in ETABS and SAP2000.',
  },
  {
    when: 'Jun – Aug 2022',
    role: 'Research Intern, Computer-Aided Engineering',
    org: 'National Taiwan University',
    text: 'A computer vision project in OpenCV and PyTorch, plus sequence models with LSTMs and GRUs.',
  },
];

const education = [
  {
    when: '2024 – 2026',
    role: 'M.S. Civil Engineering',
    org: 'National Taiwan University',
    research: true,
  },
  { when: '2019 – 2023', role: 'B.S. Civil Engineering', org: 'National Yang Ming Chiao Tung University' },
];

const tools = [
  { name: 'Structures', list: ['ETABS', 'SAP2000', 'SAFE'], used: 'Used at Envision and at NYCU.' },
  { name: 'BIM', list: ['Revit', 'IFC', 'AutoCAD'], used: "Used in my master's research, the BIM course I assist and the ISARC paper." },
  { name: 'Reality capture', list: ['Mobile LiDAR', 'Point clouds', 'Photogrammetry'], used: "Used in my master's research and in PhotoForge." },
  { name: 'Vision models', list: ['PyTorch', 'OpenCV', 'YOLO'], used: 'Used for marine debris, solar panels and at NTU CAE.' },
  { name: 'Language models and automation', list: ['LLMs', 'Agents', 'n8n'], used: 'Used in the ISARC paper, the Kreyòl dataset and GUANIN.' },
  {
    name: 'Software',
    list: ['Python', 'Next.js', 'Convex', 'Clerk', 'Zod', 'FastAPI', 'Django', 'Three.js', 'MongoDB', 'Docker'],
    used: 'Used in MaiSchool, GUANIN and PhotoForge.',
  },
];
---

<Base
  title="About"
  seoTitle="About Victor Jean Viaunel, civil engineer and developer"
  current="about"
  sheet={4}
  og="about"
  crumbs={[{ name: 'About', path: 'about/' }]}
  schema={[{ '@type': 'ProfilePage', url: new URL(url('about/'), Astro.site).href, mainEntity: personRef(Astro.site) }]}
  description="Victor Jean Viaunel (韋將) is a civil engineer and full-stack developer at National Taiwan University. Experience, education, toolbox and CV downloads."
>
  <div class="grid-paper">
    <div class="container page">
      <section class="intro">
        <div class="portrait-wrap frame is-framed" data-reveal>
          <div class="portrait-inner">
            <img
              src={url('images/victor.jpg')}
              alt="Victor Jean Viaunel smiling outdoors"
              class="portrait"
              width="280"
              height="280"
            />
            <span class="portrait-scan" aria-hidden="true"></span>
          </div>
        </div>
        <div class="intro-copy page-head">
          <p class="eyebrow">About</p>
          <h1 class="page-title">Two trades, one desk</h1>
          <p class="aka">Published as Jean Viaunel Victor. In Chinese, <span lang="zh-Hant">韋將</span>.</p>
          <div class="prose">
            <p>I came to engineering through structures: ETABS, SAP2000, SAFE, Revit and AutoCAD during my civil engineering degree at NYCU, then as a structural engineering intern at Envision. I came to software through stubbornness, working through Andrew Ng's deep learning courses on the side until I could build things on my own.</p>
            <p>The work I enjoy most needs both. My master's at NTU was about getting usable BIM out of messy scans, and I stayed on in the H-Team lab as an assistant researcher, where I also assist in Prof. Hsieh's BIM course.</p>
            <p>I have close ties to Haiti and the Caribbean. That's why some of my side work points that way, and why I spend a good part of my free time helping Haitian students find their feet in Taiwan.</p>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="container page" style="padding-top: 0">
    <section aria-labelledby="exp">
      <SectionHead no={1} id="exp" title="Experience" />
      <div class="timeline">
        {
          experience.map((e) => (
            <div class="entry" data-reveal>
              <p class="when">{e.when}</p>
              <div>
                <h3>{e.role}</h3>
                <p class="org">{e.org}</p>
                {e.html ? <p class="body-text" set:html={e.html} /> : <p class="body-text">{e.text}</p>}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="edu" style="margin-top: 72px">
      <SectionHead no={2} id="edu" title="Education" />
      {
        education.map((e) => (
          <div class="entry entry--plain" data-reveal>
            <p class="when">{e.when}</p>
            <div>
              <h3>{e.role}</h3>
              <p class="org">{e.org}</p>
              {e.research && (
                <p class="body-text">
                  Research in scan-to-BIM with mobile LiDAR, H-Team lab.{' '}
                  <a href={url('research/')}>See my research</a>
                </p>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="tools" style="margin-top: 72px">
      <SectionHead no={3} id="tools" title="Toolbox, and where I've used it" />
      <div class="tool-grid">
        {
          tools.map((t, i) => (
            <div data-reveal style={`--d: ${i % 2}`}>
              <p class="tool-name">{t.name}</p>
              <div class="chip-row">
                {t.list.map((x) => <span class="tag">{x}</span>)}
              </div>
              <p class="used">{t.used}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="cv" aria-labelledby="cvh" class="cv-box frame" data-reveal>
      <div>
        <h2 id="cvh">Curriculum vitae</h2>
        {
          cvLinks.length > 0 ? (
            <p class="body-text">
              {cvLinks.length === 2 ? `Two versions, both updated ${site.updated}.` : `Updated ${site.updated}.`}
            </p>
          ) : (
            <p class="body-text">
              Email me and I'll send the current version: an industry résumé or an academic CV.
            </p>
          )
        }
      </div>
      <div class="btn-row">
        {
          cvLinks.length > 0 ? (
            cvLinks.map((c) => (
              <a href={url(c.file)} class:list={['btn', { 'btn--primary': c.primary }]} download>
                {c.label} <span class="arrow" aria-hidden="true">↓</span>
              </a>
            ))
          ) : (
            <a href={`mailto:${site.email}?subject=CV%20request`} class="btn btn--primary">
              Request my CV <span class="arrow" aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </section>
  </div>
</Base>
