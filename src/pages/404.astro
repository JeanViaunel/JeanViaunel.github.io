---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <div class="grid-paper">
    <div class="container page page--narrow">
      <div class="page-head">
        <p class="eyebrow">Error 404</p>
        <h1 class="page-title">No points captured at this address.</h1>
        <p class="lede">The page may have moved when the site was rebuilt.</p>
        <div class="btn-row" style="margin-top: 32px">
          <a href={url('')} class="btn btn--primary">Go to the home page <span class="arrow" aria-hidden="true">→</span></a>
          <a href={url('work/')} class="btn">See my work</a>
        </div>
      </div>
    </div>
  </div>
</Base>
