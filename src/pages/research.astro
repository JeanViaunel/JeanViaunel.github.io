---
import Base from '../layouts/Base.astro';
import Authors from '../components/Authors.astro';
import SectionHead from '../components/SectionHead.astro';
import { publications } from '../data/publications';
import { site } from '../data/site';
import { url } from '../lib/url';

const areas = [
  {
    title: 'Scan-to-BIM with mobile LiDAR',
    text: "How far a quick, low-cost scan can go toward an as-built BIM model of an existing building, exported as IFC. This was the focus of my master's research.",
  },
  { title: 'BIM for energy retrofit', text: 'What engineers upgrading older buildings actually need from a scanned model.' },
  { title: 'Language models for BIM', text: 'Using LLMs to create and edit BIM models from drawings and plain-language instructions.' },
];
---

<Base title="Research" current="research" sheet={3} description="Papers and talks on scan-to-BIM, IFC and language models for BIM, from the NTU H-Team lab.">
  <div class="grid-paper">
    <div class="container page" style="padding-bottom: clamp(32px, 4vw, 48px)">
      <div class="page-head">
        <p class="eyebrow">Research</p>
        <h1 class="page-title">Papers and talks</h1>
        <p class="lede" style="max-width: 40rem">
          I'm an assistant researcher in Prof. Shang-Hsien (Patrick) Hsieh's H-Team lab at National
          Taiwan University. My work is on scan-to-BIM, IFC and using language models to build BIM
          models faster.
        </p>
        <div class="chip-row" style="margin-top: 26px">
          <a href={url('publications.bib')} download="victor-jean-viaunel.bib" class="btn btn--sm">Download all as BibTeX <span class="arrow" aria-hidden="true">↓</span></a>
          <a href={site.links.hteam} class="btn btn--sm btn--quiet">H-Team profile <span class="arrow arrow--ne" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </div>

  <div class="container page" style="padding-top: 24px">
    <section aria-labelledby="pubs">
      <SectionHead no={1} id="pubs" title="Publications" meta={`${publications.length} papers`} />

      {
        publications.map((p) => (
          <article class="paper" data-reveal>
            <div class="paper-thumb">
              {p.key === 'isarc2026' ? (
                <svg viewBox="0 0 160 100" aria-hidden="true">
                  <g fill="#FFFFFF" stroke="#1A1D21">
                    <rect class="draw" pathLength="1" stroke-dasharray="1" x="18" y="30" width="44" height="40" />
                    <line class="draw" pathLength="1" stroke-dasharray="1" style="--d: 1" x1="18" y1="50" x2="62" y2="50" />
                    <line class="draw" pathLength="1" stroke-dasharray="1" style="--d: 1" x1="40" y1="30" x2="40" y2="70" />
                  </g>
                  <g class="fade" fill="none" stroke="#C2410C" stroke-width="1.5">
                    <line x1="70" y1="50" x2="90" y2="50" />
                    <polyline points="85,45 90,50 85,55" />
                  </g>
                  <g fill="#FFFFFF" stroke="#1A1D21">
                    <polygon class="draw" pathLength="1" stroke-dasharray="1" style="--d: 2" points="98,70 120,80 142,70 120,60" />
                    <polygon class="draw" pathLength="1" stroke-dasharray="1" style="--d: 3" points="98,58 120,68 142,58 120,48" />
                    <polygon class="draw" pathLength="1" stroke-dasharray="1" style="--d: 4" points="98,46 120,56 142,46 120,36" />
                    <polygon class="draw" pathLength="1" stroke-dasharray="1" style="--d: 5" points="98,34 120,44 142,34 120,24" />
                  </g>
                </svg>
              ) : p.key === 'housing2025' ? (
                <svg viewBox="0 0 160 100" aria-hidden="true">
                  <g fill="#FFFFFF" stroke="#1A1D21">
                    <rect class="draw" pathLength="1" stroke-dasharray="1" x="30" y="22" width="100" height="56" />
                    <line class="draw" pathLength="1" stroke-dasharray="1" style="--d: 1" x1="30" y1="50" x2="130" y2="50" />
                    <line class="draw" pathLength="1" stroke-dasharray="1" style="--d: 2" x1="55" y1="22" x2="55" y2="50" />
                    <line class="draw" pathLength="1" stroke-dasharray="1" style="--d: 2" x1="80" y1="22" x2="80" y2="50" />
                    <line class="draw" pathLength="1" stroke-dasharray="1" style="--d: 2" x1="105" y1="22" x2="105" y2="50" />
                    <line class="draw" pathLength="1" stroke-dasharray="1" style="--d: 3" x1="63" y1="50" x2="63" y2="78" />
                    <line class="draw" pathLength="1" stroke-dasharray="1" style="--d: 3" x1="97" y1="50" x2="97" y2="78" />
                  </g>
                  <rect class="fade" x="80" y="22" width="25" height="28" fill="#FBEDE6" stroke="#C2410C" />
                </svg>
              ) : (
                <svg viewBox="0 0 160 100" aria-hidden="true">
                  <defs>
                    <pattern id="rDots" width="7" height="7" patternUnits="userSpaceOnUse">
                      <circle cx="1.5" cy="2" r="0.7" fill="#1A1D21" />
                      <circle cx="5" cy="5" r="0.7" fill="#1A1D21" />
                    </pattern>
                  </defs>
                  <rect x="20" y="24" width="56" height="52" fill="url(#rDots)" />
                  <rect class="draw" pathLength="1" stroke-dasharray="1" style="--d: 1" x="84" y="24" width="56" height="52" fill="#FFFFFF" stroke="#1A1D21" />
                  <rect class="fade" x="98" y="38" width="28" height="18" fill="#FBEDE6" stroke="#C2410C" />
                </svg>
              )}
            </div>
            <div class="paper-body">
              <h3 class="pub-title">{p.title}</h3>
              <Authors authors={p.authors} />
              <p class="pub-venue">{p.venue ?? p.year}</p>
              <p class="pub-summary">{p.summary}</p>
              <div class="chip-row pub-links">
                {p.links.map((l) => (
                  <a class="link-chip" href={l.href}>
                    {l.label} <span class="arrow arrow--ne" aria-hidden="true">↗</span>
                  </a>
                ))}
                <button type="button" class="link-chip" data-copy-from={`bib-${p.key}`}>Copy BibTeX</button>
              </div>
              <pre id={`bib-${p.key}`} hidden>{p.bibtex}</pre>
            </div>
          </article>
        ))
      }
    </section>

    <section aria-labelledby="area" style="margin-top: 72px">
      <SectionHead no={2} id="area" title="Research area" />
      <div class="area-grid">
        {
          areas.map((a, i) => (
            <div data-reveal style={`--d: ${i}`}>
              <span class="area-no">{String(i + 1).padStart(2, '0')}</span>
              <p class="area-title">{a.title}</p>
              <p class="body-text">{a.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="two-col">
      <section aria-labelledby="talks">
        <SectionHead no={3} id="talks" title="Talks" />
        <div class="timeline-row" data-reveal>
          <span class="date">25 Mar 2026</span>
          <span class="what">Presented <em>A Review on Scan-to-BIM for Building Energy Retrofit</em> at ICCCBE 2026, Infrastructure Systems session.</span>
        </div>
      </section>
      <section aria-labelledby="teaching">
        <SectionHead no={4} id="teaching" title="Teaching assistance" />
        <div class="timeline-row" data-reveal>
          <span class="date">Now</span>
          <span class="what">Teaching assistant for Prof. Shang-Hsien (Patrick) Hsieh's BIM course at NTU, supporting students with practical topics and their implementation ideas.</span>
        </div>
      </section>
    </div>
  </div>
</Base>
