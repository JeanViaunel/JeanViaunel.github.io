---
import Base from '../layouts/Base.astro';
import Authors from '../components/Authors.astro';
import ScanFigure from '../components/ScanFigure.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectArt from '../components/ProjectArt.astro';
import { publications } from '../data/publications';
import { featured } from '../data/projects';
import { news } from '../data/news';
import { href, isExternal, url } from '../lib/url';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import maischoolShot from '../assets/maischool-courses.png';
import roomwiseShot from '../assets/roomwise-landing.png';

const research = publications.filter((p) => p.featured);


const facts = ['Based in Taipei', 'Open to research and engineering roles', 'Works in English'];
const lead = ['I', 'teach', 'computers', 'to'];
const accent = ['read', 'buildings.'];
---

<Base current="home" sheet={1} contactFooter>
  <div class="grid-paper">
    <section class="hero container">
      <div class="hero-copy">
        <div class="hero-id">
          <span class="hero-avatar-ring">
            <Image src={portrait} alt="Portrait of Victor Jean Viaunel" class="hero-avatar" widths={[64, 128]} sizes="64px" loading="eager" />
          </span>
          <p>
            <span class="hero-name">Victor Jean Viaunel</span>
            <span class="hero-role">Civil engineer and software developer, National Taiwan University</span>
          </p>
        </div>
        <h1 data-lines>
          {lead.map((w) => <><span class="h-word"><span>{w}</span></span>{' '}</>)}
          <span class="hl">{accent.map((w, i) => <><span class="h-word"><span>{w}</span></span>{i === 0 ? ' ' : ''}</>)}</span>
        </h1>
        <p class="lede">
          I build pipelines that turn LiDAR scans and photos into BIM models an engineer can actually
          use. I'm an assistant researcher in the H-Team lab at NTU, where I'm also studying for my
          M.S., and I've led development of the MaiSchool platform since 2024.
        </p>
        <div class="btn-row">
          <a href={url('work/')} class="btn btn--primary">See my work <span class="arrow" aria-hidden="true">→</span></a>
          <a href={url('about/#cv')} class="btn">Download CV</a>
        </div>
        <ul class="hero-facts">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <ScanFigure />
    </section>
  </div>

  <section class="container" aria-label="In numbers">
    <dl class="proof">
      <div class="proof-cell" data-reveal>
        <dt>Conference papers in 2026</dt>
        <dd class="proof-n"><span data-count="3">3</span></dd>
        <dd class="proof-note">ISARC, ICCCBE and i3CE</dd>
      </div>
      <div class="proof-cell" data-reveal style="--d: 1">
        <dt>Marine debris challenge</dt>
        <dd class="proof-n"><span data-count="15">15</span>th <span class="proof-of">of 69 teams</span></dd>
        <dd class="proof-note">mAP@0.5 0.7917, two-person team</dd>
      </div>
      <div class="proof-cell" data-reveal style="--d: 2">
        <dt>Leading a live product since</dt>
        <dd class="proof-n">2024</dd>
        <dd class="proof-note">MaiSchool, built with Next.js and Convex</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="featured" class="section container">
    <SectionHead no={1} id="featured" title="Selected work" link={{ href: 'work/', label: 'All projects' }} />
    <div class="feature-grid">
      {
        featured.map((p, i) => (
          <a href={href(p.href!)} class="feature-card frame" data-reveal style={`--d: ${i}`}>
            <div class="feature-art">
              <ProjectArt id={p.id} />
            </div>
            <div class="feature-body">
              <p class="kicker kicker--accent">{p.domain}</p>
              <h3 data-vt={p.vt ? '' : undefined} style={p.vt ? `--vt: ${p.vt}` : undefined}>
                {p.title}
                {isExternal(p.href!) && <span class="arrow arrow--ne" aria-hidden="true" style="font-size: 0.9em; color: var(--muted)">{' '}↗</span>}
              </h3>
              <p class="body-text">{p.short ?? p.text}</p>
              <div class="chip-row">
                {p.results.map((m) => <span class="tag tag--accent">{m}</span>)}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="research" class="section container">
    <SectionHead no={2} id="research" title="Selected research" link={{ href: 'research/', label: 'All publications' }} />

    {
      research.map((p) => (
        <article class="pub-row">
          <p class="pub-meta">{p.meta?.map((m) => <span>{m}</span>)}</p>
          <div>
            <h3 class="pub-title">{p.title}</h3>
            <Authors authors={p.authors} />
            <p class="pub-summary">{p.short ?? p.summary}</p>
            <div class="chip-row pub-links">
              {p.page && (
                <a class="link-chip" href={url(p.page)}>How it works <span class="arrow" aria-hidden="true">→</span></a>
              )}
              {p.links.map((l) => <a class="link-chip" href={l.href}>{l.label}</a>)}
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="beyond" class="section container">
    <SectionHead no={3} id="beyond" title="Products and service" />
    <div class="products">
      {
        [
          {
            href: 'https://maischool.legendcastle.org/en',
            url: 'maischool.legendcastle.org',
            img: maischoolShot,
            alt: "MaiSchool's public course catalogue: search, subject and grade filters, and course cards",
            kicker: 'Product, since 2024',
            title: 'MaiSchool',
            text: 'A live online tutoring platform for families. As lead full-stack developer I took it from design to production: course and teacher browsing, class booking, progress tracking and parent messages.',
            results: ['Live product'],
            stack: ['Next.js', 'Convex', 'Clerk', 'Zod'],
          },
          {
            href: 'https://video.viocitostudio.me',
            url: 'video.viocitostudio.me',
            img: roomwiseShot,
            alt: 'Roomwise landing page: meetings where you stay in control, with HD video, waiting-room security, live chat and recordings',
            kicker: 'Own product, in team use',
            title: 'Roomwise',
            text: 'A web video-meeting platform my teams use for all our meetings. Not built to replace Google Meet, but so we are not limited by it, and so I could learn the real-time video stack.',
            results: ['17 registered users', '30 calls'],
            stack: ['Next.js', 'Clerk', 'Stream Video API'],
          },
        ].map((p, i) => (
          <a class="product-card frame" href={p.href} data-reveal style={`--d: ${i}`}>
            <div class="product-shot">
              <span class="product-bar" aria-hidden="true"><i></i><i></i><i></i><span>{p.url}</span></span>
              <Image src={p.img} alt={p.alt} widths={[480, 720, 960]} sizes="(min-width: 980px) 540px, 100vw" />
            </div>
            <div class="product-body">
              <p class="kicker kicker--accent">{p.kicker}</p>
              <h3>{p.title} <span class="arrow arrow--ne" aria-hidden="true">↗</span></h3>
              <p class="body-text">{p.text}</p>
              <div class="chip-row">
                {p.results.map((r) => <span class="tag tag--accent">{r}</span>)}
                {p.stack.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
          </a>
        ))
      }
    </div>
    <div class="beyond-side">
      <div>
        <p class="kicker kicker--accent">Teaching assistant</p>
        <h3>Prof. Hsieh's BIM course, NTU</h3>
        <p class="body-text">I assist in my professor's course, supporting students as they work through practical topics and their own implementation ideas.</p>
      </div>
      <div>
        <p class="kicker kicker--accent">Community</p>
        <h3>Academic Committee Lead, second term</h3>
        <p class="body-text">I help Haitian students apply to Taiwanese universities, from study plans and autobiographies to application workshops.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="news" class="section container">
    <SectionHead no={4} id="news" title="News" link={{ href: 'now/', label: 'What I’m working on now' }} />
    <ul class="dated-list news-list">
      {news.map((n) => <li class="dated"><span class="date">{n.date}</span><span class="what">{n.text}</span></li>)}
    </ul>
  </section>
</Base>
